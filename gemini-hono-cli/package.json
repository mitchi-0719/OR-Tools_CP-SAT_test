{
  "name": "gemini-hono-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "ask": "node --import tsx src/cli.ts",
    "chat": "node --import tsx src/cli.ts --interactive",
    "trace": "node --import tsx src/trace-cli.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "@google/genai": "^2.29.1",
    "@hono/node-server": "^1.19.0",
    "dotenv": "^16.6.1",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
