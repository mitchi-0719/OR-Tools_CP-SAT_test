{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setlist.local/schemas/min_gap_bands.schema.json",
  "title": "MinGapBandsConstraint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constraint_id",
    "event_id",
    "type",
    "hardness",
    "priority",
    "enabled",
    "targets",
    "params"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "constraint_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["min_gap_bands"] },
    "hardness": { "$ref": "common.schema.json#/$defs/Hardness" },
    "priority": { "$ref": "common.schema.json#/$defs/Priority" },
    "enabled": { "type": "boolean" },
    "source_text": { "type": "string" },
    "targets": { "$ref": "#/$defs/MinGapBandsTargets" },
    "params": { "$ref": "#/$defs/MinGapBandsParams" }
  },
  "$defs": {
    "MinGapBandsTargets": {
      "title": "MinGapBandsTargets",
      "type": "object",
      "additionalProperties": false,
      "required": ["band_ids"],
      "properties": {
        "band_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "MinGapBandsParams": {
      "title": "MinGapBandsParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["min_diff", "same_part_only"],
      "properties": {
        "min_diff": { "type": "integer", "minimum": 2 },
        "same_part_only": { "type": "boolean" }
      }
    }
  }
}
