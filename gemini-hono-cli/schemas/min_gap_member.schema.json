{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setlist.local/schemas/min_gap_member.schema.json",
  "title": "MinGapMemberConstraint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constraint_id",
    "event_id",
    "type",
    "hardness",
    "priority",
    "enabled",
    "targets",
    "params"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "constraint_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["min_gap_member"] },
    "hardness": { "$ref": "common.schema.json#/$defs/Hardness" },
    "priority": { "$ref": "common.schema.json#/$defs/Priority" },
    "enabled": { "type": "boolean" },
    "source_text": { "type": "string" },
    "targets": { "$ref": "#/$defs/MinGapMemberTargets" },
    "params": { "$ref": "#/$defs/MinGapMemberParams" }
  },
  "$defs": {
    "MinGapMemberTargets": {
      "title": "MinGapMemberTargets",
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id"],
      "properties": {
        "member_id": { "type": "string", "minLength": 1 }
      }
    },
    "MinGapMemberParams": {
      "title": "MinGapMemberParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["min_diff", "same_part_only"],
      "properties": {
        "min_diff": { "type": "integer", "minimum": 2 },
        "same_part_only": { "type": "boolean" }
      }
    }
  }
}
